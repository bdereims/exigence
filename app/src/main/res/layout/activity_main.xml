<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/main_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="65dp"
            android:layout_height="match_parent"
            android:background="@color/black"
            android:orientation="vertical"
            android:padding="4dp">

            <Button
                android:id="@+id/maintenance_button"
                style="@style/DashboardMenuButton"
                android:drawableTop="@drawable/ic_maintenance"
                android:text="@string/menu_maintenance"
                app:drawableTint="@android:color/white" />

            <Button
                android:id="@+id/engine_button"
                style="@style/DashboardMenuButton"
                android:drawableTop="@drawable/ic_engine"
                android:text="@string/menu_engine"
                app:drawableTint="@android:color/white" />

            <Button
                android:id="@+id/settings_button"
                style="@style/DashboardMenuButton"
                android:drawableTop="@drawable/ic_settings"
                android:text="@string/menu_settings"
                app:drawableTint="@android:color/white" />
        </LinearLayout>

        <GridLayout
            android:id="@+id/tire_dashboard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@color/black"
            android:columnCount="2"
            android:layoutDirection="ltr"
            android:padding="4dp"
            android:rowCount="2">

            <com.example.exigence.TirePanelView
                android:id="@+id/front_left_tire"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_row="0"
                android:layout_rowWeight="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp" />

            <com.example.exigence.TirePanelView
                android:id="@+id/front_right_tire"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_row="0"
                android:layout_rowWeight="1"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp" />

            <com.example.exigence.TirePanelView
                android:id="@+id/rear_left_tire"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_row="1"
                android:layout_rowWeight="1"
                android:layout_column="0"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp" />

            <com.example.exigence.TirePanelView
                android:id="@+id/rear_right_tire"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_row="1"
                android:layout_rowWeight="1"
                android:layout_column="1"
                android:layout_columnWeight="1"
                android:layout_gravity="fill"
                android:layout_margin="4dp" />
        </GridLayout>
    </LinearLayout>

    <ScrollView
        android:id="@+id/settings_screen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/black"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingEnd="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/pressure_settings"
                    android:textColor="@android:color/white"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/front_tires"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/front_threshold_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/front_pressure_range"
                    android:textColor="@android:color/white" />

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/front_threshold_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/front_tires"
                    android:stepSize="0.05"
                    android:valueFrom="1.0"
                    android:valueTo="3.0" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/rear_tires"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/rear_threshold_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rear_pressure_range"
                    android:textColor="@android:color/white" />

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/rear_threshold_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/rear_tires"
                    android:stepSize="0.05"
                    android:valueFrom="1.0"
                    android:valueTo="3.0" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/temperature_settings"
                    android:textColor="@android:color/white"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/front_tires"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/front_temperature_range_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/front_temperature_range"
                    android:textColor="@android:color/white" />

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/front_temperature_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/front_tires"
                    android:stepSize="1"
                    android:valueFrom="0"
                    android:valueTo="110" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="@string/rear_tires"
                    android:textColor="@android:color/white"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/rear_temperature_range_label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/rear_temperature_range"
                    android:textColor="@android:color/white" />

                <com.google.android.material.slider.RangeSlider
                    android:id="@+id/rear_temperature_slider"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:contentDescription="@string/rear_tires"
                    android:stepSize="1"
                    android:valueFrom="0"
                    android:valueTo="110" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/settings_back_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/back"
            android:textAllCaps="false" />
        </LinearLayout>
    </ScrollView>
</FrameLayout>
